{
	"name": "deebeebridge",
	"version": "0.2.0",
	"description": "CLI and MCP server that exposes database connections to AI agents by name, without sharing credentials.",
	"license": "MIT",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"database",
		"postgres",
		"mysql",
		"ai-agents",
		"claude-code",
		"cursor"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AbhishekMandilkar/deebee-bridge.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/AbhishekMandilkar/deebee-bridge#readme",
	"bugs": {
		"url": "https://github.com/AbhishekMandilkar/deebee-bridge/issues"
	},
	"type": "module",
	"bin": {
		"deebeebridge": "dist/cli.js",
		"dbb": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "bun run build && cp ../../README.md ../../LICENSE .",
		"postpack": "rm -f README.md LICENSE"
	},
	"dependencies": {
		"@clickhouse/client": "^1.24.1",
		"@inquirer/prompts": "^8.7.3",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"commander": "^15.0.0",
		"mysql2": "^3.24.6",
		"node-sql-parser": "^5.4.0",
		"pg": "^8.23.1",
		"pg-cursor": "^2.22.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@deebeebridge/config": "workspace:*",
		"@deebeebridge/core": "workspace:*",
		"@types/node": "catalog:",
		"tsup": "^9.0.0",
		"typescript": "catalog:",
		"vitest": "^5.0.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
